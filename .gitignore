# Python
__pycache__/
*.py[cod]
*.pyo

# Virtual environment
.venv/
venv/
ENV/
env/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# IDE
.idea/

# Build artifacts
build/
dist/
*.egg-info/

# OS
.DS_Store
Thumbs.db

# Local cognitive-engine evaluation results
batch-f-results.json

# Generated virtual lab world state (do not silently commit private runtime state)
/state/*-lab.db
/state/*-lab.db-*


# Headless AVATAR presentation state (runtime-generated, private local state)
/state/avatar-presentation.json
/state/avatar-presentation.json.tmp

# Persistent machine location state (private local coordinates)
/state/machine-locations.json
/state/machine-locations.json.tmp

# Local Sofía database recovery snapshots (private runtime state)
/state/sofia.pre-*.db
/state/sofia.pre-*.db-*


# Local Fleet PKI material (private keys/certificates; never commit)
/state/fleet-pki/

# Local pytest scratch roots
/.pytest-tmp/
/.pytest-local/

# Local runtime SQLite state and sidecars
/sofia.db
/sofia.db-*
/state/*.db
/state/*.db-*

# Local one-off failure captures
/regression-failure.log
