{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sofia.invalid/contracts/component-response.v1.schema.json",
  "title": "Sofía component response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "request_id", "correlation_id", "responder", "outcome", "payload_type", "payload_digest", "evidence_refs", "completed_at"],
  "properties": {
    "protocol": {"const": "1.0"},
    "request_id": {"$ref": "#/$defs/id"},
    "correlation_id": {"$ref": "#/$defs/id"},
    "responder": {"$ref": "component-endpoint.v1.schema.json"},
    "outcome": {"enum": ["denied", "unavailable", "failed", "cancelled", "outcome_unknown", "succeeded_reported_unverified", "succeeded_verified"]},
    "payload_type": {"oneOf": [{"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}\\.v[1-9][0-9]*$"}, {"type": "null"}]},
    "payload_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "evidence_refs": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/id"}},
    "completed_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "payload_type": {"type": "null"},
            "payload_digest": {"type": "null"}
          }
        },
        {
          "properties": {
            "payload_type": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}\\.v[1-9][0-9]*$"},
            "payload_digest": {"$ref": "#/$defs/digest"}
          }
        }
      ]
    },
    {
      "if": {"properties": {"outcome": {"const": "succeeded_verified"}}, "required": ["outcome"]},
      "then": {"properties": {"evidence_refs": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,159}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
